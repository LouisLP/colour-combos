exports[`snapshots — so a format change is visible in review > css 1`] = `
"/* japanese-colour-combos · Wada No. 1 — English Red · Cerulian Blue. Canonical mode: light. */
:root {
  /* English Red: the exact Wada hex is step 400 */
  --cc-english-red-50: #fffcfb;
  --cc-english-red-100: #ffe5d9;
  --cc-english-red-200: #fdb899;
  --cc-english-red-300: #ee9268;
  --cc-english-red-400: #d96629;
  --cc-english-red-500: #bf571e;
  --cc-english-red-600: #9e4410;
  --cc-english-red-700: #7f3202;
  --cc-english-red-800: #5c2200;
  --cc-english-red-900: #320f00;
  --cc-english-red-950: #0b0100;
  --cc-english-red: var(--cc-english-red-400);

  /* Cerulian Blue: the exact Wada hex is step 400 */
  --cc-cerulian-blue-50: #f8feff;
  --cc-cerulian-blue-100: #d1f0f5;
  --cc-cerulian-blue-200: #99d1db;
  --cc-cerulian-blue-300: #65b5c3;
  --cc-cerulian-blue-400: #0093a5;
  --cc-cerulian-blue-500: #008292;
  --cc-cerulian-blue-600: #006976;
  --cc-cerulian-blue-700: #00525c;
  --cc-cerulian-blue-800: #003a42;
  --cc-cerulian-blue-900: #001e22;
  --cc-cerulian-blue-950: #000405;
  --cc-cerulian-blue: var(--cc-cerulian-blue-400);

  /* Neutral, tinted from the combo */
  --cc-neutral-50: #f8feff;
  --cc-neutral-100: #e2eced;
  --cc-neutral-200: #bfcacc;
  --cc-neutral-300: #9fabae;
  --cc-neutral-400: #839093;
  --cc-neutral-500: #6b787a;
  --cc-neutral-600: #566163;
  --cc-neutral-700: #414b4d;
  --cc-neutral-800: #2d3537;
  --cc-neutral-900: #151b1c;
  --cc-neutral-950: #020404;

  /* accent: English Red */
  --cc-accent-50: var(--cc-english-red-50);
  --cc-accent-100: var(--cc-english-red-100);
  --cc-accent-200: var(--cc-english-red-200);
  --cc-accent-300: var(--cc-english-red-300);
  --cc-accent-400: var(--cc-english-red-400);
  --cc-accent-500: var(--cc-english-red-500);
  --cc-accent-600: var(--cc-english-red-600);
  --cc-accent-700: var(--cc-english-red-700);
  --cc-accent-800: var(--cc-english-red-800);
  --cc-accent-900: var(--cc-english-red-900);
  --cc-accent-950: var(--cc-english-red-950);

  /* accent-2: Cerulian Blue */
  --cc-accent-2-50: var(--cc-cerulian-blue-50);
  --cc-accent-2-100: var(--cc-cerulian-blue-100);
  --cc-accent-2-200: var(--cc-cerulian-blue-200);
  --cc-accent-2-300: var(--cc-cerulian-blue-300);
  --cc-accent-2-400: var(--cc-cerulian-blue-400);
  --cc-accent-2-500: var(--cc-cerulian-blue-500);
  --cc-accent-2-600: var(--cc-cerulian-blue-600);
  --cc-accent-2-700: var(--cc-cerulian-blue-700);
  --cc-accent-2-800: var(--cc-cerulian-blue-800);
  --cc-accent-2-900: var(--cc-cerulian-blue-900);
  --cc-accent-2-950: var(--cc-cerulian-blue-950);

  /* Semantic roles: light-dark(light, dark) */
  --cc-canvas: light-dark(#f4fcfd, #0d1314);
  --cc-surface: light-dark(#ffffff, #181d1d);
  --cc-surface-muted: light-dark(#e2f0f2, #212b2d);
  --cc-ink: light-dark(#162224, #dfeff1);
  --cc-ink-muted: light-dark(#5e6c6e, #99a8aa);
  --cc-border: light-dark(#c1dee3, #263f44);
  --cc-border-strong: light-dark(#7a959a, #4c666c);
  --cc-accent: light-dark(#d96629, #d96629);
  --cc-accent-text: light-dark(#b64a00, #e36f34);
  --cc-on-accent: light-dark(#000000, #000000);
  --cc-accent-2: light-dark(#0093a5, #0093a5);
  --cc-accent-2-text: light-dark(#007786, #1f9eb0);
  --cc-on-accent-2: light-dark(#000000, #000000);
}

[data-theme='light'] { color-scheme: light; }
[data-theme='dark'] { color-scheme: dark; }
"
`;

