    800: $cc-accent-800,
    900: $cc-accent-900,
    950: $cc-accent-950,
  ),
  'accent-2': (
    50: $cc-accent-2-50,
    100: $cc-accent-2-100,
    200: $cc-accent-2-200,
    300: $cc-accent-2-300,
    400: $cc-accent-2-400,
    500: $cc-accent-2-500,
    600: $cc-accent-2-600,
    700: $cc-accent-2-700,
    800: $cc-accent-2-800,
    900: $cc-accent-2-900,
    950: $cc-accent-2-950,
  ),
);

$cc-semantic: (
  light: (
    'canvas': #f4fcfd,
    'surface': #ffffff,
    'surface-muted': #e2f0f2,
    'ink': #162224,
    'ink-muted': #5e6c6e,
    'border': #c1dee3,
    'border-strong': #7a959a,
    'accent': #d96629,
    'accent-text': #b64a00,
    'on-accent': #000000,
    'accent-2': #0093a5,
    'accent-2-text': #007786,
    'on-accent-2': #000000,
  ),
  dark: (
    'canvas': #0d1314,
    'surface': #181d1d,
