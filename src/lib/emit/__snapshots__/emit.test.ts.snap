$cc-cerulian-blue-700: #00525c;
$cc-cerulian-blue-800: #003a42;
$cc-cerulian-blue-900: #001e22;
$cc-cerulian-blue-950: #000405;
$cc-cerulian-blue: $cc-cerulian-blue-400;

// Neutral, tinted from the combo
$cc-neutral-50: #f8feff;
$cc-neutral-100: #e2eced;
$cc-neutral-200: #bfcacc;
$cc-neutral-300: #9fabae;
$cc-neutral-400: #839093;
$cc-neutral-500: #6b787a;
$cc-neutral-600: #566163;
$cc-neutral-700: #414b4d;
